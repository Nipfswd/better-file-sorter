{
  "PluginsFolder": "Plugins",
  "JournalFolder": "Journals",
  "DefaultStrategy": "extension",
  "DetectDuplicates": true,
  "ConflictResolution": "rename",
  "WatchFolders": [
    {
      "Path": "C:\\Users\\Noah\\Downloads",
      "Strategy": "extension",
      "DebounceMs": 3000
    }
  ],
  "RulesFallbackStrategy": "extension",
  "Rules": [
    {
      "Name": "Big videos get their own bucket",
      "Match": { "Extensions": [".mp4", ".mkv", ".mov"], "MinSizeMB": 500 },
      "Folder": "BigVideo"
    },
    {
      "Name": "Camera photos sorted by date taken",
      "Match": { "NamePattern": "^IMG_\\d+" },
      "UsePlugin": "date"
    },
    {
      "Name": "Old installers archived",
      "Match": { "Extensions": [".exe", ".msi"], "OlderThanDays": 180 },
      "Folder": "Archive/OldInstallers"
    }
  ]
}
