<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>DirectorySorter.Plugins.ByExtension</AssemblyName>
    <!-- Output straight into the App's Plugins folder so F5 debugging picks it up immediately -->
    <OutputPath>..\DirectorySorter.App\bin\$(Configuration)\net8.0\Plugins\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\DirectorySorter.Core\DirectorySorter.Core.csproj">
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>
</Project>
